@model ReviewPage
@{ ViewData["Title"] = "Kiểm duyệt đánh giá"; var hidden = (bool)ViewData["Hidden"]!; }
<h1>Kiểm duyệt đánh giá</h1>
<nav class="nav nav-tabs">
<a asp-action="Reviews" class="nav-link @(!hidden ? "active" : "")">Đang hiển thị</a>
<a asp-action="Reviews" asp-route-hidden="true" class="nav-link @(hidden ? "active" : "")">Đã ẩn</a></nav>
@if (Model.Items.Count == 0) { <p>Chưa có đánh giá ở trang này.</p> }
@foreach (var review in Model.Items) {
<section class="panel my-3"><h2 class="h5">@review.ProductName</h2><partial name="_ReviewRow" model="review" />
<form asp-action="ReviewStatus" asp-route-id="@review.Id" method="post">
<input type="hidden" name="hidden" value="@hidden.ToString()" /><input type="hidden" name="page" value="@Model.Page" />
<button class="btn btn-outline-primary">@(hidden ? "Hiển thị lại" : "Ẩn đánh giá")</button></form></section>
}
<nav>
@if (Model.Page > 1) { <a asp-action="Reviews" asp-route-hidden="@hidden" asp-route-page="@(Model.Page-1)">Trang trước</a> }
@if ((long)Model.Page * Model.PageSize < Model.Total) { <a asp-action="Reviews" asp-route-hidden="@hidden" asp-route-page="@(Model.Page+1)">Trang sau</a> }
</nav>
