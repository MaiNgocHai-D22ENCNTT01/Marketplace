@model SellerPage
@{ ViewData["Title"] = "Kênh người bán"; }
<h1>Kênh người bán</h1>
<nav class="nav nav-tabs"><a class="nav-link active" asp-action="Index">Tổng quan</a><a class="nav-link" asp-action="Reviews">Quản lý Đánh giá</a><a class="nav-link" asp-controller="FlashSales" asp-action="Seller">Flash Sale</a></nav>
<p><a asp-controller="Chat" asp-action="Index">Hộp thư khách hàng</a></p>
<div class="kpis"><div class="kpi"><i class="bi bi-wallet2"></i><strong>@Model.Sales.Revenue.ToString("N0") ₫</strong><small>Doanh thu đơn hoàn tất</small></div>
<div class="kpi"><i class="bi bi-bag"></i><strong>@Model.Sales.Orders</strong><small>Tổng đơn hàng</small></div>
<div class="kpi"><i class="bi bi-box"></i><strong>@Model.Products.Count</strong><small>Sản phẩm</small></div></div>
<section class="panel"><h2>Sản phẩm bán chạy</h2>
@if (Model.Sales.BestSellers.Count == 0) { <p>Chưa có đơn hoàn tất.</p> }
<ol>@foreach (var row in Model.Sales.BestSellers) { <li>@row.Name · @row.Quantity đã bán</li> }</ol>
</section><section class="panel"><h2>Đơn của gian hàng</h2>
@if (Model.Orders.Count == 0) { <p>Chưa có đơn hàng.</p> }
@foreach (var order in Model.Orders)
{
    var next = order.Status switch { "PENDING" => "CONFIRMED", "CONFIRMED" or "READY_FOR_PICKUP" => "SHIPPING", "SHIPPING" or "DELIVERED" => "COMPLETED", _ => null };
    <article class="order-card"><strong>@order.Id <span class="status" data-status="@order.Status">@order.Status</span></strong>
    <p>@order.Recipient<br/>@string.Join(", ",order.Items) · @order.Total.ToString("N0") ₫</p>
    @if (next != null) { <form asp-action="Advance" asp-route-id="@order.Id" method="post"><button class="btn btn-primary" name="status" value="@next">Chuyển sang @next</button></form> }
    </article>
}
</section><section class="panel"><h2>Sản phẩm</h2><a asp-action="Edit" class="btn btn-primary mb-2">Đăng sản phẩm</a>
<div class="table-responsive"><table class="table"><thead><tr><th>Tên</th><th>Trạng thái</th><th>Quản lý</th></tr></thead><tbody>
@foreach (var p in Model.Products)
{
<tr><td>@p.Data.Name</td><td><span class="status" data-status="@p.Status">@p.Status</span></td><td><a asp-action="Edit" asp-route-id="@p.Id">Chỉnh sửa</a>
@if (p.Status == "ACTIVE") { <form asp-action="Remove" asp-route-id="@p.Id" method="post" class="d-inline"><button class="btn btn-link">Ngừng bán</button></form> }</td></tr>
}
</tbody></table></div>
</section>
