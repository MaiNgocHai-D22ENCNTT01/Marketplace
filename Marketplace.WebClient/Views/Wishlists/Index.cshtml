@model List<Marketplace.Application.Catalog.ProductSummary>
@{ ViewData["Title"] = "Danh sách yêu thích"; }
<section class="collection" data-wishlist-page><h1>Danh sách yêu thích</h1>
@if (Model.Count == 0)
{
    <p class="empty">Bạn chưa có sản phẩm yêu thích. <a asp-controller="Home" asp-action="Index">Khám phá sản phẩm</a></p>
}
else
{
    <div class="product-grid">@foreach (var product in Model) { <partial name="_ProductCard" model="product" /> }</div>
}
</section>
