@{ ViewData["Title"] = "Đăng ký"; }
<section class="panel auth"><i class="bi bi-person feature-icon"></i><h1>Đăng ký khách hàng</h1>
<form asp-action="Register" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <label class="form-label">Họ tên<input class="form-control" name="FullName" autocomplete="name" required maxlength="255" /></label><br />
    <label class="form-label">Email<input class="form-control" type="email" name="Email" autocomplete="username" required maxlength="255" /></label><br />
    <label class="form-label">Mật khẩu (ít nhất 8 ký tự)<input class="form-control" type="password" name="Password" autocomplete="new-password" required minlength="8" maxlength="128" /></label><br />
    <button class="btn btn-primary">Đăng ký</button>
</form><p class="mt-3 mb-0">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></section>
