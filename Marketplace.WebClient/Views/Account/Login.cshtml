@{ ViewData["Title"] = "Đăng nhập"; }
<section class="panel auth"><i class="bi bi-person feature-icon"></i><h1>Đăng nhập</h1>
<form asp-action="Login" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
    <label class="form-label">Email<input class="form-control" type="email" name="Email" autocomplete="username" required maxlength="255" /></label><br />
    <label class="form-label">Mật khẩu<input class="form-control" type="password" name="Password" autocomplete="current-password" required maxlength="128" /></label><br />
    <button class="btn btn-primary">Đăng nhập</button>
</form><p class="mt-3 mb-0">Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></p></section>
