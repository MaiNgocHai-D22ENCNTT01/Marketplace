# Copy to .env locally. Supply the real password privately; never commit it.
# Docker Desktop reaches Windows PostgreSQL via host.docker.internal.
MARKETPLACE_AI_DSN=host=host.docker.internal port=5432 dbname=marketplace_mvp user=postgres password=CHANGE_ME
MARKETPLACE_AI_THREADS=2
MARKETPLACE_DB_CONNECTIONS=16
MARKETPLACE_AI_QUEUE=128
MARKETPLACE_AI_BATCH_SIZE=32
MARKETPLACE_AI_BATCH_MS=12
